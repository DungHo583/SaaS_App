{
  "name": "saas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d postgres",
    "mail:up": "docker compose up -d mailpit",
    "db:migrate:platform": "node --env-file=.env.local scripts/migrate.mjs platform",
    "db:migrate:tenants": "node --env-file=.env.local scripts/migrate.mjs tenants",
    "tenant:create": "node --env-file=.env.local scripts/create-tenant.mjs",
    "db:test": "node db/tests/tenant-rules.test.mjs",
    "test:e2e": "node tests/e2e-flow.test.mjs"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "^5.3.3",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "next": "16.4.6",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
